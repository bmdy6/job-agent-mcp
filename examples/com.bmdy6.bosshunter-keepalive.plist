<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bmdy6.bosshunter-keepalive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/job-agent/mcp/.venv/bin/python</string>
    <string>/ABSOLUTE/PATH/TO/job-agent/examples/bosshunter_keepalive.py</string>
    <string>--ego-browser</string><string>/ABSOLUTE/PATH/TO/.local/bin/ego-browser</string>
    <string>--config</string>
    <string>/ABSOLUTE/HOME/Library/Application Support/BossHunter-示例用户/config.yaml</string>
  </array>
  <!-- Five-minute cadence validated by the A/B experiment; no official TTL. -->
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/TO/private-logs/bosshunter-keepalive.stdout.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/TO/private-logs/bosshunter-keepalive.stderr.log</string>
</dict>
</plist>
